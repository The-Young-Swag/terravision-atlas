{
  "name": "terravision-atlas",
  "version": "1.0.0",
  "type": "module",
  "description": "TerraVision: Atlas — Explore. Monitor. Plan. Visualize. A zero-cost, client-side geospatial platform.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4900",
