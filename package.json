    "@tensorflow/tfjs": "^4.20.0",
    "@turf/turf": "^7.4.0",
    "axios": "^1.20.0",
    "cesium": "^1.144.0",
    "chart.js": "^5.3.1",
    "chroma-js": "^3.2.0",
    "dayjs": "^1.11.23",
    "framer-motion": "^13.1.1",
    "idb": "^8.0.3",
    "kmljs": "^0.0.1",
    "lucide-react": "^1.33.0",
    "maplibre-gl": "^6.5.0",
    "mathjs": "^15.2.2",
